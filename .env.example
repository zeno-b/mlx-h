# Local LLM — example environment configuration.
# Copy to `.env` and edit. NEVER commit a real .env (it is gitignored).
# Every variable is optional; sensible defaults are chosen from your RAM.
# Values shown are examples/placeholders, not real secrets.

# ============================================================ Model / core ==
# MODEL_ID=mlx-community/Qwen2.5-Coder-7B-Instruct-4bit   # overrides RAM auto-pick; also an alias (tiny, fast, balanced, coder, reasoning, vision, large)
# MODEL_ALIASES=                 # JSON {"name": "repo-id"} merged over the built-in aliases; invalid JSON is ignored
# BENCH_MIN_DECODE_TPS=10        # `deploy.py bench --sweep` recommends nothing slower than this (1..200)
# BENCH_HEADROOM_GB=0            # RAM kept free when judging fit; 0 = max(2.5GB, RAM/4)
# CONTEXT_SIZE=8192
# MAX_TOKENS=512
# TEMPERATURE=0.7
# HISTORY_TURNS=20
# WEB_PORT=8000
# MODEL_PORT=8080
# APP_NAME=Local LLM
# APP_LOGO=                                               # URL/path/emoji

# ================================================================= Logging ==
LOG_LEVEL=INFO                 # TRACE | DEBUG | INFO | WARN | ERROR
LOG_FORMAT=json                # json (aggregation-ready) | text (local dev)
# LOG_DIR=                      # default ./logs
LOG_CHAT_CONTENT=metadata      # disabled | metadata (length+fingerprint) | full (redacted)
LOG_MAX_BYTES=10485760         # rotate at 10 MB
LOG_BACKUP_COUNT=10            # keep 10 rotations
LOG_RETENTION_DAYS=14          # prune rotated logs older than this

# ========================================================== Authentication ==
AUTH_ENABLED=0                 # 0 = single local admin (default); 1 = require login
AUTH_SESSION_TTL_HOURS=168     # session lifetime (7 days)
AUTH_COOKIE_NAME=llm_session
AUTH_COOKIE_SECURE=0           # set 1 when served over HTTPS (behind a proxy)
# First-run admin. If AUTH_ADMIN_PASSWORD is unset, a random one is printed to
# the log ONCE at first startup. Change it after logging in.
AUTH_ADMIN_USERNAME=admin
# AUTH_ADMIN_PASSWORD=change-me-on-first-run
# Optional non-admin dev/test account (NOT a backdoor). Remove for production.
AUTH_ALLOW_TEST_USER=0
AUTH_TEST_USERNAME=test
# AUTH_TEST_PASSWORD=
# Failed-login throttle: N failures per (client IP + username) inside the window,
# and 3N per client IP across all usernames (stops a spray), then 429 +
# Retry-After. scrypt verification is deliberately expensive, so
# this guards CPU as well as credentials. A successful login clears the counter.
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_S=300

# ============================================= Microsoft Entra ID / OIDC ====
OIDC_ENABLED=0
# OIDC_TENANT_ID=00000000-0000-0000-0000-000000000000
# OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
# OIDC_CLIENT_SECRET=your-client-secret            # SECRET — never commit
# OIDC_REDIRECT_URI=https://llm.example.com/api/auth/oidc/callback
# OIDC_AUTHORITY=                                   # default login.microsoftonline.com/<tenant>/v2.0
# OIDC_SCOPES=openid profile email
# OIDC_ADMIN_EMAILS=alice@example.com,bob@example.com
# OIDC_ADMIN_GROUPS=<group-object-id>,<group-object-id>
# OIDC_ADMIN_ROLES=Admin                           # app role value(s)
# OIDC_DEFAULT_ROLE=user
# Terminal sign-in with Microsoft (device code): an Entra app with "Allow public
# client flows" enabled (may be the same app as OIDC_CLIENT_ID). Empty = off.
# OIDC_CLI_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Personal API tokens (Settings, `deploy.py wire --login`): lifetime in days and
# the longest a user may request; 0 = tokens never expire.
API_TOKEN_DEFAULT_TTL_DAYS=90

# ============================================= Office 365 / Microsoft Graph ==
# Powers the "office365" agent capability (mail, files, calendar). Leave unset
# to ship the capability as configurable stubs; supply an Azure AD app to connect.
# O365_TENANT_ID=00000000-0000-0000-0000-000000000000
# O365_CLIENT_ID=00000000-0000-0000-0000-000000000000
# O365_CLIENT_SECRET=your-client-secret            # SECRET — never commit
# O365_SCOPES=https://graph.microsoft.com/.default

# Wall-clock cap for ONE agent inside a multi-agent run (/api/agents/run), so a
# wedged or unreachable model server cannot hold the request open.
AGENT_RUN_TIMEOUT=300

# ================================= Cluster: Mac Mini (primary) + Studio =====
NODE_ROLE=primary             # primary | secondary
# NODE_NAME=                    # default: auto-detected from hw.model (e.g. macbook-pro, mac-studio)
# STUDIO_NODE_URL=http://studio.local:8000         # the Studio app's base URL; empty = single node
# NODE_TOKEN=shared-inter-node-secret              # SECRET — required for multi-node
# --- Routing factors (no arbitrary fixed thresholds) ---
ROUTE_MAX_ACTIVE=2            # in-flight generations per node before offloading
ROUTE_QUEUE_DEPTH=4
ROUTE_CPU_PCT=85             # CPU% above which a node is "overloaded" (needs psutil; skipped if unmeasurable)
ROUTE_LOAD_RATIO=4           # load average PER CORE that counts as saturated (a ratio, not a %)
ROUTE_MEM_PCT=85             # memory% above which a node is "overloaded"
ROUTE_SLA_MS=0              # 0 = off; else spill to Studio if primary latency exceeds this
ROUTE_COOLDOWN_S=20        # circuit breaker: skip a tripped node this long, then allow one half-open trial
LARGE_MODEL_MARKERS=14B,32B,70B,72B   # models that require the high-memory Studio
HEARTBEAT_INTERVAL=10
HEARTBEAT_TIMEOUT=30
NODE_PROBE_TIMEOUT=8
# --- More than one peer, pairing, layer sharding (README "Multi-Mac cluster") ---
# CLUSTER_NODES=                 # JSON list of peers: [{"name": "studio", "url": "https://...", "ram_gb": 128}]
# CLUSTER_HOSTFILE=              # mlx.distributed hostfile for MODEL_BACKEND=mlx-distributed (default data/cluster_hostfile.json)
# CLUSTER_PYTHON=                # python path on the other hosts for mlx-distributed (default: the same path as here)
# NODE_TOKEN may be a comma list (a, b) so a token can be rotated without downtime.
# --- Remote access and node security (README "Remote access and node security") ---
# WEB_HOST=127.0.0.1             # bind address; anything else is logged as remote.bind_non_loopback
# TRUSTED_PROXIES=               # proxy IPs/CIDRs whose X-Forwarded-For is believed
# PUBLIC_BASE_URL=               # origin browsers use, e.g. https://llm.example.com; OIDC redirect derives from it
# NODE_CA_FILE=                  # CA bundle to verify peer TLS
# NODE_CLIENT_CERT=              # client certificate for mutual TLS to peers
# NODE_CLIENT_KEY=
# NODE_ALLOW_PLAINTEXT=0         # 1 allows http:// to peers outside loopback, private and tailnet ranges
# NODE_E2E_KEY=                  # SECRET: same key on every node seals node traffic (needs `cryptography`)

# =========================================== Claude history import limits ===
IMPORT_MAX_ZIP_BYTES=209715200        # 200 MB upload cap
IMPORT_MAX_FILES=20000                 # max entries in the archive
IMPORT_MAX_UNCOMPRESSED_BYTES=1073741824   # 1 GB expanded (zip-bomb guard)
IMPORT_MAX_FILE_BYTES=52428800         # 50 MB per file

# ================================================================= Search ===
# The web search provider is LOCKED to DuckDuckGo Lite. There is intentionally
# no variable to select another engine; SEARCH_BACKEND is accepted only as a
# DuckDuckGo-Lite alias and anything else is ignored.
SEARCH_RESULTS=5

# =============================================== Networking / reverse proxy ==
# ALLOWED_ORIGINS=https://llm.example.com          # extra CORS origins behind a proxy

# ======================================================= Admission control ==
# Each in-flight generation holds its own KV cache in the same unified memory as
# the model weights, so this is a memory limit as much as a fairness one. The
# default scales with RAM (2 on 8-16GB, 3 on 24-32GB, 4 on 48GB+). Requests past
# MAX_CONCURRENT_GENERATIONS wait; requests past that plus the queue get 503.
# MAX_CONCURRENT_GENERATIONS=2
GENERATION_QUEUE_DEPTH=4        # waiting slots per running slot
# Memory-aware admission (off by default): a queued request also waits while
# free memory minus the KV bytes already reserved would fall below the floor.
# A lone request is always admitted. GET /api/health shows the queue.
# ADMISSION_MEMORY_AWARE=0
# ADMISSION_MIN_FREE_MB=         # default by RAM: 384 (8GB), 768 (up to 24GB), 1536 above
# Seconds a streaming chat answer keeps running after the browser disconnects,
# so a reload resumes it. 0 stops it on disconnect.
# TURN_DETACH_GRACE_S=30

# ======================================================= Inference backend ==
# Restart-only. GET /api/backends lists the engines and why the live one is
# configured the way it is. Unset keeps the stock mlx_lm.server command line.
# MODEL_BACKEND=mlx-lm           # mlx-lm | mlx-lm-turbo | mlx-engine | openai-external | mlx-distributed
# DRAFT_MODEL=                   # speculative decoding: a repo id or "auto"; empty is off
# NUM_DRAFT_TOKENS=0             # 0 keeps the server default
# BACKEND_COMMAND=               # openai-external: e.g. my-engine --model {model} --port {port} --adapter-path {adapter}
# BACKEND_CAPABILITIES=          # openai-external: e.g. batching,prompt_cache,vision
# BACKEND_EXTRA_ARGS=            # appended to any backend's command line

# ===================================================== Agent / tools / misc =
# AGENT_ENABLED=0
# AGENT_ESCALATION=1
# TOOL_CALL_FORMAT=auto          # auto | json | openai | hermes | qwen3_coder | glm | llama3 | mistral | pythonic | gemma | deepseek | kimi | harmony
# TOOL_CALL_REPAIR=1             # fix near-miss tool-call JSON (trailing commas, quotes); 0 = strict
# APPROVAL_DEFAULT_MODE=all      # a user's approvals mode until they change it in the header: all (ask every action) | risky (ask for changes) | off (don't ask)
# TOOL_APPROVAL_MODE=off         # administrator floor, stricter than a user's choice wins: off | risky (ask before write/exec/external) | all (ask before every call)
# TOOL_APPROVAL_UNATTENDED=deny  # what "ask" becomes when nobody can answer: deny | allow
# TOOL_APPROVAL_TIMEOUT_S=120    # an unanswered approval prompt counts as a refusal
# TOOL_APPROVAL_TAINT=1          # re-ask for write/exec/external after a turn read web/MCP/mail content
# TOOL_APPROVAL_ROLES=           # JSON per-role rules, e.g. {"user": {"risk:exec": "deny"}}
# V1_DEFAULT_MODE=agent          # /v1 API with a plain model name: agent (this app's agent) | raw (client tools)
# V1_RAW_ENABLED=1               # 0 refuses raw/<model> on the /v1 API (everything runs the agent)
# MCP_SERVERS=                   # JSON: stdio {"name","command","args","env"} or http {"name","url","headers","type":"http"}; ${VAR} expands
# MCP_SERVER_ENABLED=0           # 1 serves this app's tools to MCP clients at POST /mcp (signed-in users only)
# ROLE_CAPABILITIES=             # JSON capability keys per role, e.g. {"user": ["web_search","file_ops","mcp"], "admin": ["*"]}
# EXTRA_TOOLS=                   # newer tools for the default agent: "" none | all | browse_page,git,http_request,...
# DATABASE_URLS=                 # read-only SQLite for the database tool: {"name": "/path/to.db"}
# NOTIFY_WEBHOOK_URL=            # notify tool: ntfy topic URL or Slack-compatible webhook (secret)
# NOTIFY_MACOS=1                 # notify tool: macOS banner for an admin when the server runs on this Mac's screen
# IMAGE_GEN_COMMAND=             # image_generate template, e.g. mflux-generate --model schnell --prompt {prompt} --output {output}
# IMAGE_GEN_TIMEOUT_S=600
# O365_USER=                     # fallback mailbox for email/calendar/contacts (local runs and admins without an address)
# AUTO_CONTINUE=1
# AUTO_CONTINUE_MAX=3
# ALLOW_SHELL=0
# ALLOW_PYTHON=0
# PROJECT_DIR=/path/to/repo
# Paths no file tool, @reference, download or generated document may read or
# write, relative to the project/workspace root (gitignore-style: a slash
# anchors at the root, no slash matches at any depth). Restart to change.
# FILE_DENY_GLOBS=.env,.env.*,data/**,logs/**,adapters/**,.venv/**,*.db,*.db-wal,*.db-shm,*.key,*.pem,secrets/**,.git/**
# OUTPUTS_DIR=outputs            # where create_document puts a bare file name; empty = the root
# HF_HOME=~/.cache/huggingface
# HF_HUB_CACHE=                  # model cache dir; overrides HF_HOME's default
# PROMPT_CACHE_DIR=

# ASSISTANT_IDENTITY=            # who the model says it is; "" disables the identity line

# ========================================== Cloud fallback for huge prompts ==
# Off by default: nothing leaves this machine. When on, a prompt that does not
# fit the local context, would prefill for CLOUD_MIN_PREFILL_S or more, or has at
# least CLOUD_MIN_PROMPT_TOKENS tokens may go to the cloud model, only for allowed
# users and only after they consent (audio is never sent, secrets are redacted).
# CLOUD_FALLBACK_ENABLED=0
# CLOUD_PROVIDER=openai            # openai (any OpenAI-compatible /chat/completions) | anthropic (/v1/messages)
# CLOUD_BASE_URL=                  # empty = the provider's public API
# CLOUD_MODEL=                     # empty keeps the fallback unavailable
# CLOUD_API_KEY=                   # secret; never shown in Settings or logs
# CLOUD_CONSENT=per_request        # per_request (ask every time) | per_user (also offers conversation/always grants)
# CLOUD_MIN_PREFILL_S=120          # at the measured local prompt speed; 0 = off
# CLOUD_MIN_PROMPT_TOKENS=0        # 0 = off
# CLOUD_ALLOWED_ROLES=admin        # role names, user:<id or username>, or *
# CLOUD_MAX_TOKENS_PER_USER_MONTH=0  # prompt + reply tokens per UTC month; 0 = no cap

# ============================================ Evaluation and regression suite ==
# `python deploy.py eval [--suite a,b] [--live] [--save-baseline] [--compare]`
# or Settings > Admin > Evals. EVAL_ON_PROMOTE=1 evaluates every adapter a
# retrain promotes (live tool-calling, RAG and multi-turn suites) and rolls it
# back when a suite scores more than EVAL_MAX_REGRESSION below the previous
# adapter's baseline. Off by default.
# EVAL_ON_PROMOTE=0
# EVAL_MAX_REGRESSION=0.05         # 0..1; 0.05 = five points on a 100-point suite score
# ==================================== Advanced tunables (all optional) ======
# Generated from the code, so these names and defaults match Config exactly.
# Everything here already has a sensible RAM-aware default; set one only to
# override it. `python deploy.py --print-config` prints the RESOLVED values.

# ADAPTER=latest
# AGENT_MAX_STEPS=6
# AGENT_TOOLS=
# ALLOW_LOCAL_FETCH=0
# AUTO_FETCH_CHAR_CAP=
# AUTO_FETCH_RESULTS=2
# AUTO_ITERATE_ROUNDS=2
# ARTIFACT_REPLY_HEADROOM=640
# AUTO_RETRAIN_THRESHOLD=0
# CALC_MAX_FACTORIAL=1000
# CALC_MAX_RESULT_BITS=str(1 << 16
# CHAT_IDLE_SECONDS=45
# CHUNK_LARGE_PROMPTS=1
# CHUNK_SIZE_RATIO=0.4
# CHUNK_TRIGGER_RATIO=0.6
# CODE_MAX_TOKENS=1536
# DEBUG_PROMPTS=0
# DISABLE_THINKING=0
# DRIFT_CHECK_ENABLED=1
# DOCKER_IMAGE=python:3.12-slim
# EXEC_BACKEND=local
# EXEC_ENV_PASSTHROUGH=
# EXEC_MEMORY_MB=2048
# EXEC_MAX_FILE_MB=256
# EXEC_PIDS_LIMIT=512
# EXEC_GUARDRAIL=1
# Workspaces: 1 = each non-admin user's file tools work in their own
# workspace/users/<id>, and chats can be confined to a project (per-user or
# shared). Admins keep PROJECT_DIR. Local shell/Python are NOT confined by this;
# use EXEC_BACKEND=docker on a multi-user install.
# WORKSPACES_ENABLED=0
# Folders an admin may place shared projects under (comma list). Empty: the
# workspace folder and PROJECT_DIR.
# WORKSPACE_ROOTS=
# TEST_TIMEOUT=180
# FAST_PATH=1
# DATE_IN_PROMPT=1
# HARD_STEP_CAP=24
# HEDGE_ESCALATION=1
# INCREMENTAL_REASONING=1
# KNOWLEDGE_TRIAGE=1
# Read the app's own terms (knowledge base, codebase, skills, memory, history,
# tasks, document formats) as instructions before the router; 0 = router only.
# INTENT_LEXICON_ENABLED=1
# KV_BITS=0
# KV_GROUP_SIZE=64
# MAX_CONCURRENT_TASKS=1
# MAX_KV_SIZE=0
# MIN_MAX_TOKENS=128
# MODEL_CATALOG=
# MODEL_CUTOFF=
# QUANTIZED_KV_START=1024
# RAG_ENABLED=1
# RAG_PASSAGES=4
# RAG_SCOPE=
# Retrieval ignores query words found in more than this share of the indexed
# documents (from 20 documents up); 1.0 turns it off.
# RAG_DF_CEILING=0.2
# READY_WAIT_TIMEOUT=40
# REASONING_MAX_STEPS=6
# REASONING_MIN_CHARS=80
# REASONING_SIGNALS=2
# REASONING_STEP_TIMEOUT=45
# REASONING_TOKENS=
# REASONING_VISIBLE=1
# When the think-first instruction is added under REASONING_VISIBLE: auto (only
# for catalogue thinking models), always, or never.
# REASONING_PROMPT=auto
# Reasoning tokens one agent step may spend before it is asked for the answer
# only; 0 = no cap.
# THINK_MAX_TOKENS=384
# REPETITION_CONTEXT_SIZE=64
# REPETITION_PENALTY=1.1
# REPETITION_PENALTY_ENABLED=0
# RESILIENT_RETRIES=3
# RETRIEVAL_DEADLINE=90
# SEARCH_BACKEND=duckduckgo_lite
# SHOW_INTERNALS=1
# STABLE_PREFIX=1
# STALL_TIMEOUT=60
# SUMMARISE_OVER_CHARS=2500
# SUMMARISE_TOOL_RESULTS=1
# SYSTEM_PROMPT=_DEFAULT_SYSTEM_PROMPT
# TASK_ARTIFACT_CHARS=8000
# TASK_POLL_SECONDS=2
# TASK_STATE_ENABLED=1
# TEST_COMMAND=
# TOOL_RAW_CHARS=20000
# TOOL_RESULT_CHARS=1500
# TOOL_TEMPERATURE=0.0
# TOOL_TIMEOUT=30
# TRAIN_DROP_OVER_LENGTH=1
# TRAIN_EPOCHS=3
# TRAIN_FINE_TUNE_TYPE=lora
# TRAIN_ITERS=0
# TRAIN_LORA_DROPOUT=0.0
# TRAIN_LORA_RANK=8
# TRAIN_LORA_SCALE=20.0
# TRAIN_LR=3e-5
# TRAIN_MAX_BACKUPS=5
# TRAIN_MAX_ITERS=2000
# TRAIN_MIN_EXAMPLES=16
# TRAIN_MIN_ITERS=40
# TRAIN_NUM_LAYERS=8
# TRAIN_ON_TOOL_CALLS=1
# TRAIN_PROMOTE_BEST=1
# TRAIN_REPLAY_RATIO=0.15
# TRAIN_SEQ_LEN=1024
# TRAIN_BATCH_SIZE=1
# TRAIN_TIMEOUT=7200
# TRAIN_TOOL_EXAMPLES=400
# TRAIN_TOOL_QUALITY=rated
# TRAIN_TOOL_RATIO=3.0
# TRAIN_VAL_CHECK=1
# TRAIN_VAL_SPLIT=0.1
# TRAIN_VAL_TOLERANCE=0.02
# Training method (train_methods.py): sft (default, the mlx_lm.lora loop above,
# unchanged), dpo, orpo, grpo (these three need `pip install mlx-lm-lora` and are
# refused without it, never run as SFT), kto (export only: no installed trainer
# implements it). ORPO needs no reference model and is the one that fits on 8 GB.
# TRAIN_METHOD=sft
# 1 = size layers/rank/batch/window/checkpointing from RAM, the model's
# config.json and the corpus (TRAIN_SEQ_LEN stays the ceiling), and refuse a run
# that will not fit. Preview with GET /api/train/plan or `deploy.py train-plan`.
# TRAIN_AUTOPILOT=0
# TRAIN_BETA=0.1
# Reference model for DPO/GRPO: empty = the base model; else a FULL model
# directory (fuse an adapter first) or a Hugging Face repo id.
# TRAIN_REFERENCE_ADAPTER=
# GRPO reward terms (experimental): tool_call, format, length, with weights.
# TRAIN_GRPO_REWARDS=tool_call:1.0,format:0.5,length:0.25
# 1 = keep a preference adapter even without a comparable metric (GRPO never
# has one). 0 rolls such runs back.
# TRAIN_PROMOTE_UNGATED=0
